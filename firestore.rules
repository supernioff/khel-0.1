rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read: if true;
      allow write: if true;
    }

    match /scores/{scoreId} {
      allow read: if true;
      allow write: if true;
    }

    match /rooms/{roomId} {
      allow read, write: if true;
    }
  }
}
